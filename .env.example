# Copy this file to .env and fill in your values before starting the stack.
#   cp .env.example .env
#
# Variables marked REQUIRED must be set, otherwise the connector will refuse to start
# or produce incomplete output without them.
#
# All other variables have working defaults suitable for local development
# against the default istSOS4 dev instance.

# ---------------------------------------------------------------------------
# STA connection
# ---------------------------------------------------------------------------

# Base URL of the OGC SensorThings API v1.1 endpoint to harvest from.
# No trailing slash. Must be reachable from inside the connector container.
# When running via Docker Desktop, use host.docker.internal instead of localhost.
STA_BASE_URL=http://host.docker.internal:8018/istsos4/v1.1

# ---------------------------------------------------------------------------
# STAC output
# ---------------------------------------------------------------------------

# REQUIRED => public base URL of the STAC endpoint served by this connector.
# Used to build self/root/parent/collection links in every STAC object.
# Must match the URL at which external clients (STAC browsers, QGIS) reach /stac.
# The connector refuses to start if this is unset or empty.
STAC_ROOT_HREF=http://localhost:8020/stac

# ---------------------------------------------------------------------------
# Harvester tuning
# ---------------------------------------------------------------------------

# $top value per paginated Things request.
HARVESTER_PAGE_SIZE=100

# Retry attempts per request for network errors and 5xx responses.
# 4xx responses are never retried, since they indicate a configuration problem.
HARVESTER_MAX_RETRIES=3

# Per-request HTTP timeout in seconds.
HARVESTER_TIMEOUT_SECONDS=30.0

# ---------------------------------------------------------------------------
# Cache
# ---------------------------------------------------------------------------

# TTL in seconds for the in-memory catalog cache.
# After expiry the next catalog request triggers a fresh harvest from the STA instance.
# Lower = more up-to-date metadata, higher STA load.
# Higher = less STA load, slightly stale metadata.
CACHE_TTL_SECONDS=300